{
  "id": "example-phase2-logic-math",
  "name": "Phase 2 逻辑控制与数据处理示例",
  "description": "演示条件判断、循环、数值运算和字符串操作节点的综合使用",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "node-1",
      "type": "loop",
      "name": "生成数字序列",
      "inputs": {
        "loop_type": "range",
        "start_num": 1,
        "end_num": 6,
        "step": 1,
        "max_iterations": 1000
      },
      "position": {"x": 100, "y": 100}
    },
    {
      "id": "node-2",
      "type": "math_operation",
      "name": "计算总数乘以100",
      "inputs": {
        "operation": "multiply",
        "operand_a": "${count}",
        "operand_b": 100
      },
      "position": {"x": 300, "y": 100}
    },
    {
      "id": "node-3",
      "type": "condition",
      "name": "检查结果是否大于300",
      "inputs": {
        "condition_type": "compare",
        "left_value": "${result}",
        "operator": ">",
        "right_value": "300"
      },
      "position": {"x": 500, "y": 100}
    },
    {
      "id": "node-4",
      "type": "string_operation",
      "name": "生成报告文本",
      "inputs": {
        "operation": "format",
        "input_string": "处理完成! 共{}个项目, 计算结果: {}, 超过阈值: {}",
        "param1": "[\"${count}\", \"${result}\", \"${true_path}\"]"
      },
      "position": {"x": 700, "y": 100}
    },
    {
      "id": "node-5",
      "type": "file_write",
      "name": "保存报告",
      "inputs": {
        "file_path": "output/phase2_report.txt",
        "content": "${result}",
        "mode": "overwrite"
      },
      "position": {"x": 900, "y": 100}
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "source_node_id": "node-1",
      "target_node_id": "node-2"
    },
    {
      "id": "conn-2",
      "source_node_id": "node-2",
      "target_node_id": "node-3"
    },
    {
      "id": "conn-3",
      "source_node_id": "node-3",
      "target_node_id": "node-4"
    },
    {
      "id": "conn-4",
      "source_node_id": "node-4",
      "target_node_id": "node-5"
    }
  ],
  "variables": {}
}
